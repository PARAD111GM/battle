{
  "name": "rivetfall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/browser-smoke.mjs",
    "bundle:standalone": "npm run build && node scripts/standalone.mjs",
    "soak": "node scripts/run-soak.mjs",
    "test:ui": "node scripts/browser-ui.mjs",
    "test:bots": "node scripts/browser-bots.mjs",
    "cloud:start": "bash scripts/cloud-start.sh",
    "cloud:install": "bash scripts/cloud-install.sh",
    "test:standalone": "node scripts/browser-standalone.mjs",
    "test:input": "node tests/input-browser.mjs",
    "test:audio": "node tests/audio-browser.mjs",
    "test:editor": "node scripts/browser-editor.mjs",
    "test:polish": "node scripts/browser-polish.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^3.2.4"
  }
}
